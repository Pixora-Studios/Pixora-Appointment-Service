PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
MONGO_URI=mongodb://localhost:27017/pixora-appointments
MASTER_ADMIN_KEY=replace-with-long-random-string

# Provider: Hostinger/Titan Mail SMTP — hello@pixorastudios.com is hosted on Hostinger, not Gmail
# Find exact values in hPanel > Emails > select mailbox > Manage > Configuration Settings
# > Manual Configuration. Default Hostinger values are smtp.hostinger.com on port 465 (SSL).
# Password is the mailbox login password — there is no separate "app password" for Hostinger.
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true
HOSTINGER_SMTP_USER=hello@pixorastudios.com
HOSTINGER_SMTP_PASS=

# Provider: Brevo — primary tier candidate (free: 300/day)
# Brevo API key — found at app.brevo.com under Settings > SMTP & API > API Keys
BREVO_API_KEY=

# Provider: Resend — secondary tier candidate (free: 3000/month, 100/day)
# Resend API key — found at resend.com/api-keys
RESEND_API_KEY=

FROM_EMAIL=hello@pixorastudios.com
FROM_NAME=PixoraStudios

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Comma-separated list of allowed origins for CORS, e.g., http://localhost:3000,https://clinic1.com
ALLOWED_ORIGINS=
